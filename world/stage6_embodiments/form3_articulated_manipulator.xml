<mujoco model="carl_form3_manipulator">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.002" iterations="50" integrator="implicitfast" solver="Newton" tolerance="1e-10"/>

  <visual>
    <headlight ambient="0.32 0.32 0.38" diffuse="0.65 0.65 0.75" specular="0 0 0"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.035 0.045 0.09" rgb2="0.055 0.07 0.14"/>
    <material name="floor_mat" texture="grid" texrepeat="8 8" reflectance="0.08" rgba="0.05 0.06 0.12 1"/>
    <material name="pedestal_mat" rgba="0.18 0.20 0.25 1" reflectance="0.2"/>
    <material name="arm_mat" rgba="0.15 0.55 0.85 1" reflectance="0.4" shininess="0.8"/>
    <material name="link_mat" rgba="0.85 0.88 0.92 1" reflectance="0.5"/>
    <material name="gripper_mat" rgba="0.12 0.14 0.18 1" reflectance="0.3"/>
    <material name="pad_mat" rgba="0.95 0.45 0.10 1"/>
    <material name="target_mat" rgba="0.95 0.15 0.35 1" emission="0.3" reflectance="0.3"/>
    <material name="bin_mat" rgba="0.10 0.75 0.40 1" reflectance="0.3"/>
    <material name="projectile_mat" rgba="1.0 0.80 0.10 1" emission="0.5" reflectance="0.4"/>
  </asset>

  <default>
    <geom contype="1" conaffinity="1" condim="4"
          friction="1.2 0.01 0.0005"
          solimp="0.99 0.999 0.001" solref="0.004 1"/>
  </default>

  <worldbody>
    <light name="top_light" pos="0 0 4" dir="0 0 -1" ambient="0.3 0.3 0.35"/>
    <light name="side_light" pos="2 2 3" dir="-1 -1 -1" diffuse="0.4 0.4 0.45"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat"/>

    <!-- Workstation Pedestal Table -->
    <geom name="table" type="box" size="0.60 0.60 0.15" pos="0.25 0.15 0.15" material="pedestal_mat"/>

    <!-- 4-DOF Articulated Robotic Arm + Gripper (FIRST in body hierarchy for clean qpos[0..5]) -->
    <body name="arm_base" pos="0.0 0.0 0.30">
      <geom name="base_geom" type="cylinder" size="0.08 0.04" material="pedestal_mat" mass="5.0"/>

      <!-- Joint 1: Base Yaw Rotation -->
      <body name="link1_yaw" pos="0 0 0.04">
        <joint name="j_yaw" type="hinge" axis="0 0 1" range="-2.8 2.8" damping="1.2"/>
        <geom name="l1_geom" type="cylinder" size="0.05 0.05" pos="0 0 0.05" material="arm_mat" mass="1.2"/>

        <!-- Joint 2: Shoulder Pitch -->
        <body name="link2_shoulder" pos="0 0 0.10">
          <joint name="j_shoulder" type="hinge" axis="0 1 0" range="-1.8 1.8" damping="1.2"/>
          <geom name="l2_geom" type="capsule" size="0.035 0.12" pos="0.06 0 0.12" euler="0 0.5 0" material="link_mat" mass="1.0"/>

          <!-- Joint 3: Elbow Pitch -->
          <body name="link3_elbow" pos="0.12 0 0.24">
            <joint name="j_elbow" type="hinge" axis="0 1 0" range="-2.2 2.2" damping="1.0"/>
            <geom name="l3_geom" type="capsule" size="0.028 0.10" pos="0.08 0 0.02" euler="0 1.3 0" material="arm_mat" mass="0.8"/>

            <!-- Joint 4: Wrist Pitch/Roll -->
            <body name="link4_wrist" pos="0.18 0 0.03">
              <joint name="j_wrist" type="hinge" axis="0 1 0" range="-1.8 1.8" damping="0.5"/>
              <geom name="wrist_geom" type="cylinder" size="0.025 0.02" euler="0 1.5708 0" material="link_mat" mass="0.4"/>

              <!-- Eye/Vision Sensor Mounted on Wrist -->
              <camera name="wrist_cam" pos="0.04 0 0.04" xyaxes="0 -1 0 0 0 1" fovy="70"/>

              <!-- Two-Finger Gripper Hand -->
              <body name="hand_palm" pos="0.04 0 0">
                <geom name="palm_geom" type="box" size="0.015 0.035 0.02" material="gripper_mat" mass="0.3"/>

                <!-- Left Finger -->
                <body name="finger_left" pos="0.025 0.030 0">
                  <joint name="j_finger_l" type="slide" axis="0 1 0" range="-0.025 0.010" damping="0.5"/>
                  <geom name="finger_l_geom" type="box" size="0.025 0.006 0.015" material="pad_mat" mass="0.04" friction="3.0 0.01 0.001"/>
                  <geom name="finger_l_lip" type="box" size="0.025 0.008 0.004" pos="0 -0.006 -0.015" material="pad_mat" mass="0.01" friction="3.0 0.01 0.001"/>
                </body>

                <!-- Right Finger -->
                <body name="finger_right" pos="0.025 -0.030 0">
                  <joint name="j_finger_r" type="slide" axis="0 -1 0" range="-0.025 0.010" damping="0.5"/>
                  <geom name="finger_r_geom" type="box" size="0.025 0.006 0.015" material="pad_mat" mass="0.04" friction="3.0 0.01 0.001"/>
                  <geom name="finger_r_lip" type="box" size="0.025 0.008 0.004" pos="0 0.006 -0.015" material="pad_mat" mass="0.01" friction="3.0 0.01 0.001"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Target Delivery Basket (at x=0.0, y=0.45, z=0.31) -->
    <geom name="bin_base" type="box" size="0.12 0.12 0.01" pos="0.0 0.45 0.31" material="bin_mat"/>
    <geom name="bin_w1" type="box" size="0.12 0.01 0.06" pos="0.0 0.56 0.37" material="bin_mat"/>
    <geom name="bin_w2" type="box" size="0.12 0.01 0.06" pos="0.0 0.34 0.37" material="bin_mat"/>
    <geom name="bin_w3" type="box" size="0.01 0.12 0.06" pos="-0.11 0.45 0.37" material="bin_mat"/>
    <geom name="bin_w4" type="box" size="0.01 0.12 0.06" pos="0.11 0.45 0.37" material="bin_mat"/>

    <!-- Manipulable Target Block (For Pick-and-Place: freejoint qpos[6..12]) -->
    <body name="target_block" pos="0.38 0.0 0.32">
      <freejoint name="block_joint"/>
      <geom name="block_geom" type="box" size="0.022 0.022 0.022" material="target_mat" mass="0.06" friction="2.0 0.01 0.001"/>
    </body>

    <!-- Dynamic In-Flight Ballistic Projectile (For Throwing / Catching: freejoint qpos[13..19]) -->
    <body name="projectile_ball" pos="0.80 0.0 0.40">
      <freejoint name="proj_joint"/>
      <geom name="proj_geom" type="sphere" size="0.024" material="projectile_mat" mass="0.04" friction="1.5 0.01 0.0005"/>
    </body>
  </worldbody>

  <actuator>
    <position name="act_yaw" joint="j_yaw" kp="800.0" kv="80.0" ctrlrange="-2.8 2.8"/>
    <position name="act_shoulder" joint="j_shoulder" kp="450.0" kv="45.0" ctrlrange="-1.8 1.8"/>
    <position name="act_elbow" joint="j_elbow" kp="350.0" kv="35.0" ctrlrange="-2.2 2.2"/>
    <position name="act_wrist" joint="j_wrist" kp="200.0" kv="20.0" ctrlrange="-1.8 1.8"/>
    <position name="act_grip_l" joint="j_finger_l" kp="150.0" kv="15.0" ctrlrange="-0.025 0.010"/>
    <position name="act_grip_r" joint="j_finger_r" kp="150.0" kv="15.0" ctrlrange="-0.025 0.010"/>
  </actuator>

  <equality>
    <weld name="block_weld" body1="target_block" body2="hand_palm" active="false" relpose="0 0 0 1 0 0 0"/>
    <weld name="proj_weld" body1="projectile_ball" body2="hand_palm" active="false" relpose="0 0 0 1 0 0 0"/>
  </equality>
</mujoco>
