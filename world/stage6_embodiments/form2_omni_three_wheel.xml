<mujoco model="carl_form2_omni_base">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.005" iterations="50" integrator="implicitfast" solver="Newton" tolerance="1e-10"/>

  <visual>
    <headlight ambient="0.3 0.3 0.35" diffuse="0.6 0.6 0.7" specular="0 0 0"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.04 0.05 0.10" rgb2="0.06 0.08 0.16"/>
    <material name="floor_mat" texture="grid" texrepeat="8 8" reflectance="0.1" rgba="0.05 0.06 0.12 1"/>
    <material name="chassis" rgba="0.18 0.25 0.32 1" reflectance="0.4"/>
    <material name="wheel" rgba="0.10 0.12 0.15 1"/>
    <material name="wall" rgba="0.12 0.14 0.22 1"/>
    <material name="exit" rgba="0.0 0.85 0.45 1" emission="0.6"/>
  </asset>

  <default>
    <geom contype="1" conaffinity="1" condim="3"
          friction="0.80 0.005 0.0001"
          solimp="0.99 0.999 0.001" solref="0.004 1"/>
  </default>

  <worldbody>
    <light name="sun" pos="0 0 6" dir="0 0 -1" directional="true" ambient="0.3 0.3 0.35"/>
    <geom name="floor" type="plane" size="8 8 0.1" pos="0 0 0" material="floor_mat"/>

    <!-- Slalom Obstacles -->
    <geom name="obs1" type="cylinder" size="0.15 0.3" pos="0.8 0.3 0.3" material="wall"/>
    <geom name="obs2" type="cylinder" size="0.15 0.3" pos="1.6 -0.3 0.3" material="wall"/>
    <geom name="obs3" type="cylinder" size="0.15 0.3" pos="2.4 0.3 0.3" material="wall"/>
    <geom name="goal_line" type="box" size="0.05 0.8 0.01" pos="3.2 0.0 0.01" material="exit"/>

    <!-- Form 2: 3-Wheel Omni-Directional Holonomic Base (Planar 3-DOF Ground Kinematics) -->
    <body name="carl_omni" pos="0.0 0.0 0.045">
      <joint name="root_x" type="slide" axis="1 0 0" damping="1.0"/>
      <joint name="root_y" type="slide" axis="0 1 0" damping="1.0"/>
      <joint name="root_yaw" type="hinge" axis="0 0 1" damping="0.5"/>
      <geom name="chassis_geom" type="cylinder" size="0.16 0.025" material="chassis" mass="2.2"/>

      <!-- Wheel 1: Front (0 deg) -->
      <body name="wheel1" pos="0.13 0.0 0">
        <joint name="w1_joint" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="w1_geom" type="cylinder" size="0.035 0.015" euler="1.5708 0 0" material="wheel" mass="0.15"/>
      </body>

      <!-- Wheel 2: Rear-Left (120 deg) -->
      <body name="wheel2" pos="-0.065 0.1126 0" euler="0 0 2.0944">
        <joint name="w2_joint" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="w2_geom" type="cylinder" size="0.035 0.015" euler="1.5708 0 0" material="wheel" mass="0.15"/>
      </body>

      <!-- Wheel 3: Rear-Right (-120 deg) -->
      <body name="wheel3" pos="-0.065 -0.1126 0" euler="0 0 -2.0944">
        <joint name="w3_joint" type="hinge" axis="0 1 0" damping="0.02"/>
        <geom name="w3_geom" type="cylinder" size="0.035 0.015" euler="1.5708 0 0" material="wheel" mass="0.15"/>
      </body>

      <!-- Head Pan & Eye Sensor -->
      <body name="head" pos="0.05 0.0 0.06">
        <joint name="neck_pan" type="hinge" axis="0 0 1" range="-1.2 1.2" damping="0.05"/>
        <geom name="head_g" type="box" size="0.035 0.035 0.03" rgba="0.15 0.15 0.20 1" mass="0.25"/>
        <camera name="eye_cam" pos="0.036 0 0" xyaxes="0 -1 0 0 0 1" fovy="65"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="act_vx" joint="root_x" kv="40.0"/>
    <velocity name="act_vy" joint="root_y" kv="40.0"/>
    <velocity name="act_wz" joint="root_yaw" kv="20.0"/>
    <position name="act_pan" joint="neck_pan" kp="8.0" kv="0.8"/>
  </actuator>
</mujoco>
